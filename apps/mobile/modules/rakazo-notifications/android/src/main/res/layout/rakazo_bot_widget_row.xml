<?xml version="1.0" encoding="utf-8"?>
<!-- One bot: its avatar, its name over its latest task, and its state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rakazo_widget_bot"
  android:layout_width="match_parent"
  android:layout_height="52dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <FrameLayout
    android:layout_width="36dp"
    android:layout_height="36dp">
    <ImageView
      android:id="@+id/rakazo_widget_avatar"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:src="@drawable/rakazo_widget_avatar" />
    <TextView
      android:id="@+id/rakazo_widget_initial"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:textColor="@color/rakazo_widget_on_avatar"
      android:textSize="16sp"
      android:textStyle="bold" />
  </FrameLayout>

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="8dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/rakazo_widget_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/rakazo_widget_foreground"
      android:textSize="15sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/rakazo_widget_task"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/rakazo_widget_muted"
      android:textSize="13sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/rakazo_widget_state"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
